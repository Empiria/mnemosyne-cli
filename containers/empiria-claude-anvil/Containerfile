ARG BASE_IMAGE=empiria-claude:latest
FROM ${BASE_IMAGE}
USER root

# Playwright system dependencies for browser testing
RUN npx playwright install-deps chromium

# Anvil CLI: schema validation for anvil.yaml and client_code/**/form_template.yaml
RUN npm install -g @anvil-works/anvil-cli

# Browsers must live outside /home/scion — SCION bind-mounts the agent's
# host-side home over it at runtime, shadowing anything baked there
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN mkdir -p /opt/ms-playwright && chown scion:scion /opt/ms-playwright

USER scion

# Playwright browser + pytest integration
# uv venv doesn't include pip — use uv pip to install into the venv
ENV PATH="/home/scion/.local/bin:/home/scion/.venv/bin:$PATH"
RUN uv pip install pytest-playwright && \
    playwright install chromium

# Inherit USER root from base image (see empiria-claude Containerfile)
USER root

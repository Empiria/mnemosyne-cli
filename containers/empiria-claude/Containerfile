# Empiria capability image for SCION agents (Phase 33.3 SBR-3.2 tier-2)
# Extends scion-claude with qmd, ctx7, uv, gh, ripgrep.
#
# Multi-stage build: the builder stage carries the rustup toolchain (~1.5 GiB)
# needed only to compile native Python wheels at install time; the runtime
# stage receives just the compiled artefacts under /opt/empiria via
# COPY --from=builder and never installs rustup. Combined with Plan 01's
# tier-1 cleanup this targets the D-10 acceptance bar of < 4 GiB.
ARG BASE_IMAGE=scion-claude:latest

# ============================================================================
# Stage 1: builder — has rustup, uv, network for compilation.
# Nothing from this stage ships except /opt/empiria (COPY'd into runtime).
# ============================================================================
FROM ${BASE_IMAGE} AS builder
ARG TARGETARCH
# ARG MNEMOSYNE_REV declared IN THIS STAGE per RESEARCH Pitfall 4 — multi-stage
# builds keep an independent layer cache per stage, so the cache-bust ARG must
# be re-declared here or the mnemosyne-cli install layer stays warm even when
# the remote branch advances.
ARG MNEMOSYNE_REV=unset
USER root

# rustup: Rust toolchain for compiling native Python wheels. Build-time ONLY —
# the runtime stage never sees this; only the compiled wheels in
# /opt/empiria/.venv survive into the runtime image.
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
ENV PATH="/root/.cargo/bin:$PATH"

# uv installer (build-stage uv produces the venv that the runtime stage
# receives via COPY --from=builder; runtime re-installs its own small uv
# binary separately for project container.toml deps).
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Empiria install root + Python interpreter + venv. All destined for
# /opt/empiria which is COPY'd verbatim into the runtime stage. /opt/empiria
# (not /home/scion) survives SCION's runtime mount overlay of /home/scion
# (Phase 33.1 Plan 33.1-05 finding).
RUN mkdir -p /opt/empiria
# UV_PYTHON_INSTALL_DIR redirects the interpreter under /opt/empiria so the
# venv's `python` symlink stays valid after the COPY into runtime.
ENV UV_PYTHON_INSTALL_DIR=/opt/empiria/python
RUN uv python install 3.13
RUN uv venv /opt/empiria/.venv
ENV VIRTUAL_ENV="/opt/empiria/.venv"

# mnemosyne CLI: vault operational commands.
# uv pip can exit 0 with a partial install under network flakiness; the
# `test -x` + `--help` guard fails the build if the binary did not materialise.
# .pyc / __pycache__ are stripped here (in the builder) so the COPY'd
# /opt/empiria carries no build-cache cruft into the runtime image.
RUN echo "Installing mnemosyne-cli (cache-bust rev=${MNEMOSYNE_REV})" \
 && uv pip install git+https://github.com/Empiria/mnemosyne-cli.git \
 && test -x /opt/empiria/.venv/bin/mnemosyne \
 && /opt/empiria/.venv/bin/mnemosyne --help >/dev/null \
 && find /opt/empiria/.venv -name "*.pyc" -delete \
 && find /opt/empiria/.venv -name "__pycache__" -type d -exec rm -rf {} +

# Chown so the runtime stage's COPY preserves scion-owned permissions.
# (Runtime re-chowns as belt-and-braces; this is for the COPY semantics.)
RUN chown -R 1000:1000 /opt/empiria

# ============================================================================
# Stage 2: runtime — slim image, NO rustup. Inherits everything else from
# scion-claude:latest; receives only /opt/empiria from the builder stage.
# ============================================================================
FROM ${BASE_IMAGE}
ARG TARGETARCH
# ARG MNEMOSYNE_REV re-declared per RESEARCH Pitfall 4 (per-stage cache).
ARG MNEMOSYNE_REV=unset
USER root

# GitHub CLI + ripgrep + openssh-client.
# openssh-client provides the `ssh` binary git needs to push/pull over SSH
# remotes (git@github.com:…) using the host ssh-agent forwarded to
# /run/ssh-agent by the SCION template. It is NOT in the scion-claude base,
# so agents could not use SSH git remotes without it.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends gh ripgrep openssh-client && \
    rm -rf /var/lib/apt/lists/*

# CUDA 13 runtime libs for node-llama-cpp GPU acceleration (requires host driver >=590)
# Only available for x86_64 — skip on arm64
RUN if [ "${TARGETARCH}" = "amd64" ]; then \
        curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/debian12/x86_64/cuda-keyring_1.1-1_all.deb \
            -o /tmp/cuda-keyring.deb && \
        dpkg -i /tmp/cuda-keyring.deb && rm /tmp/cuda-keyring.deb && \
        apt-get update && \
        apt-get install -y --no-install-recommends cuda-cudart-13-0 libcublas-13-0 && \
        rm -rf /var/lib/apt/lists/*; \
    fi

# ----- COPY artifacts from builder -----
# /opt/empiria carries: the Python 3.13 interpreter, the venv with mnemosyne-cli
# installed, .pyc/__pycache__ already stripped. The rustup toolchain that
# produced the native wheels stays in the builder stage and is NOT copied.
# /opt/empiria (not /home/scion) survives SCION's runtime mount overlay of
# /home/scion (Phase 33.1 Plan 33.1-05 finding).
COPY --from=builder /opt/empiria /opt/empiria
RUN chown -R scion:scion /opt/empiria

# qmd: semantic vault search (install + strip unused platform binaries)
RUN npm install -g @tobilu/qmd && \
    NPM_PREFIX=$(npm prefix -g) && \
    rm -rf "$NPM_PREFIX/lib/node_modules/@tobilu/qmd/node_modules/@node-llama-cpp/win-"* \
           "$NPM_PREFIX/lib/node_modules/@tobilu/qmd/node_modules/@node-llama-cpp/mac-"* && \
    if [ "${TARGETARCH}" = "arm64" ]; then \
        rm -rf "$NPM_PREFIX/lib/node_modules/@tobilu/qmd/node_modules/@node-llama-cpp/linux-x64"*; \
    else \
        rm -rf "$NPM_PREFIX/lib/node_modules/@tobilu/qmd/node_modules/@node-llama-cpp/linux-arm"*; \
    fi && \
    npm cache clean --force

# Playwright drop (D-11 / SBR-3.2-PLAYWRIGHT): NO-OP confirmed.
# Phase 33.3 RESEARCH verified via `podman run --rm <image> which playwright`
# that playwright is NOT present in either scion-claude base or this layer.
# If a future scion-claude base ships playwright, add an explicit removal here.
# Verified: 2026-05-19 — playwright/, /usr/bin/playwright, /opt/playwright NOTFOUND.

# ctx7: library documentation lookup
RUN npm install -g ctx7 && npm cache clean --force

USER scion

# Pre-create qmd cache dir so volume mounts don't make it root-owned
RUN mkdir -p ~/.cache/qmd

# uv binary: managed environment. uv is re-installed in the runtime stage
# (small ~30 MB binary) because the entrypoint uses it for project container.toml
# deps. The persistent venv AND the Python interpreter it points at arrive from
# the builder stage under /opt/empiria so neither survives the SCION /home/scion
# mount overlay.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/home/scion/.local/bin:$PATH"

# Reset env paths to point at the COPY'd venv. UV_PYTHON_INSTALL_DIR keeps
# `uv python` consistent with the interpreter materialised by the builder.
ENV UV_PYTHON_INSTALL_DIR=/opt/empiria/python
ENV VIRTUAL_ENV="/opt/empiria/.venv"
ENV PATH="/opt/empiria/.venv/bin:$PATH"

# Sanity check that the COPY'd mnemosyne-cli is still functional after the
# stage boundary — fails the build if the multi-stage COPY dropped anything.
RUN test -x /opt/empiria/.venv/bin/mnemosyne \
 && /opt/empiria/.venv/bin/mnemosyne --help >/dev/null

# Claude Code: native install tracking the stable channel, scion-writable
# install dir so the background auto-updater can land new versions in
# place over the agent's lifetime.
#
# Mechanism. Anthropic's native installer (https://claude.ai/install.sh)
# writes a versioned layout to $HOME/.local/share/claude/versions/<v>/
# plus a symlink at $HOME/.local/bin/claude that claude maintains itself
# on auto-update. We install as the scion user with HOME=/opt/claude so
# the binary lives outside the /home/scion mount overlay AND is writable
# by the agent at runtime — when claude detects a new release on its
# channel, it writes versions/<new>/ and re-targets
# /opt/claude/.local/bin/claude to the new version with no operator
# action required.
#
# Channel: passing `latest` to install.sh tracks the latest release
# channel. We deliberately track latest (not stable) so agents reach
# new models the day they ship — stable lags ~a week and, concretely,
# 2.1.150 (stable) did NOT carry opus-4-8 while 2.1.159 (latest) did,
# leaving agents on the `opus` alias resolving to an older Opus than
# the operator's host. The canonical .claude.json seed sets
# autoUpdatesChannel:"latest" so subsequent auto-updates also follow
# latest. Trade-off accepted: we forgo stable's regression-skipping
# for host parity / model currency.
#
# History: an earlier Plan 33.2-03 iteration pinned a specific version
# (2.1.110) with DISABLE_AUTOUPDATER=1, justified by the npm-global
# installer's broken writability behavior. That rationale dissolved
# once we migrated off npm-global to the native installer (fdb7271);
# the only remaining argument for pinning was build determinism, which
# we trade for host parity here (host auto-updates too). Build-time
# image freshness is still deterministic per CI run (stable resolves
# to whatever stable is when the CI build fires).
USER root
RUN mkdir -p /opt/claude \
 && chown -R scion:scion /opt/claude \
 && npm uninstall -g @anthropic-ai/claude-code \
 && npm cache clean --force
USER scion
# `HOME=… curl … | bash` only sets HOME for curl — the piped bash inherits
# the shell environment, so install.sh would see HOME=/home/scion and put
# the binary outside /opt/claude. `env HOME=… bash -c …` propagates HOME
# to the bash that actually runs install.sh.
RUN env HOME=/opt/claude bash -c 'curl -fsSL https://claude.ai/install.sh | bash -s latest && /opt/claude/.local/bin/claude --version'
USER root
ENV PATH="/opt/claude/.local/bin:$PATH"
RUN test "$(command -v claude)" = "/opt/claude/.local/bin/claude"
USER scion

# Pre-create dep-cache subdirs so named volume is agent-owned on first mount
RUN mkdir -p ~/.dep-cache/uv ~/.dep-cache/ms-playwright ~/.dep-cache/cargo

# GSD: phase-based workflow skills, agents, and hooks for Claude Code.
# Migrated from gsd-build/get-shit-done-cc to open-gsd/get-shit-done-redux —
# the new package declares gsd-sdk + gsd-tools as proper bin entries, so npm
# creates the PATH symlinks natively and the manual `ln -sf` is no longer
# needed. Two-step install:
#   1. `npm install -g @opengsd/get-shit-done-redux` puts the installer
#      (`get-shit-done-redux`) plus `gsd-sdk` and `gsd-tools` on PATH.
#   2. `get-shit-done-redux --claude --global` runs the installer (writes
#      config into ~/.claude/; --global is the installer's own flag, NOT
#      npm -g).
# The which-checks fail the build if npm did not register the bin entries.
RUN npm install -g @opengsd/get-shit-done-redux \
 && get-shit-done-redux --claude --global \
 && which gsd-tools >/dev/null \
 && which gsd-sdk   >/dev/null \
 && npm cache clean --force

# Community hooks gap. The npm package's installer enables two opt-in
# SessionStart/PreToolUse hooks in ~/.claude/settings.json that reference
# gsd-session-state.sh and gsd-validate-commit.sh, but the npm-packaged
# install does NOT ship those scripts. Result: every claude invocation in
# a fresh agent errors with "no such file" before the opt-in check inside
# the hooks can short-circuit (the hooks themselves are no-ops unless
# .planning/config.json sets hooks.community=true). We ship the scripts
# from this repo's community-hooks/ directory into a known build-time
# location at /opt/empiria/community-hooks/; the vault's post-start.sh
# copies them into the agent's live ~/.claude/hooks/ after the
# get-shit-done-redux re-install runs. See agents/scion-template/hooks/
# post-start.sh in the vault for the deposit step. Surfaced during Phase
# 33.2 UAT — backlog item to upstream into @opengsd/get-shit-done-redux.
COPY --chmod=0755 community-hooks/*.sh /opt/empiria/community-hooks/

# Run as root so sciontool init can chown mounted volumes before dropping
# to scion. Requires the podman ExecUser fix (scion PR #XX) so the broker
# execs as scion to find the tmux socket at /tmp/tmux-1000/.
USER root

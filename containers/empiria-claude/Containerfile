# Empiria capability image for SCION agents
# Extends scion-claude with qmd, ctx7, uv, gh, ripgrep
ARG BASE_IMAGE=scion-claude:latest
FROM ${BASE_IMAGE}
ARG TARGETARCH
USER root

# GitHub CLI + ripgrep
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends gh ripgrep && \
    rm -rf /var/lib/apt/lists/*

# CUDA 13 runtime libs for node-llama-cpp GPU acceleration (requires host driver >=590)
# Only available for x86_64 — skip on arm64
RUN if [ "${TARGETARCH}" = "amd64" ]; then \
        curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/debian12/x86_64/cuda-keyring_1.1-1_all.deb \
            -o /tmp/cuda-keyring.deb && \
        dpkg -i /tmp/cuda-keyring.deb && rm /tmp/cuda-keyring.deb && \
        apt-get update && \
        apt-get install -y --no-install-recommends cuda-cudart-13-0 libcublas-13-0 && \
        rm -rf /var/lib/apt/lists/*; \
    fi

# qmd: semantic vault search (install + strip unused platform binaries)
RUN npm install -g @tobilu/qmd && \
    NPM_PREFIX=$(npm prefix -g) && \
    rm -rf "$NPM_PREFIX/lib/node_modules/@tobilu/qmd/node_modules/@node-llama-cpp/win-"* \
           "$NPM_PREFIX/lib/node_modules/@tobilu/qmd/node_modules/@node-llama-cpp/mac-"* && \
    if [ "${TARGETARCH}" = "arm64" ]; then \
        rm -rf "$NPM_PREFIX/lib/node_modules/@tobilu/qmd/node_modules/@node-llama-cpp/linux-x64"*; \
    else \
        rm -rf "$NPM_PREFIX/lib/node_modules/@tobilu/qmd/node_modules/@node-llama-cpp/linux-arm"*; \
    fi

# ctx7: library documentation lookup
RUN npm install -g ctx7

# Empiria install root that survives SCION's runtime mount overlay of /home/scion.
# The broker bind-mounts <grove>/agents/<agent>/home:/home/scion at agent start,
# which clobbers anything installed under /home/scion (Phase 33.1 Plan 33.1-05
# finding). Tools that must be available inside a SCION agent are installed under
# /opt/empiria/ instead.
USER root
RUN mkdir -p /opt/empiria && chown scion:scion /opt/empiria
USER scion

# Pre-create qmd cache dir so volume mounts don't make it root-owned
RUN mkdir -p ~/.cache/qmd

# uv + Python: managed environment. uv installer goes to ~/.local/bin (build-time
# only — not used at runtime inside SCION agents). The persistent venv AND the
# Python interpreter it points at live under /opt/empiria/ so neither survives
# the SCION /home/scion mount overlay.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/home/scion/.local/bin:$PATH"
# UV_PYTHON_INSTALL_DIR controls where `uv python install` materialises the
# interpreter. Default is ~/.local/share/uv/python (lives under /home/scion);
# we redirect it to /opt/empiria so the venv's `python` symlink stays valid
# at agent runtime.
ENV UV_PYTHON_INSTALL_DIR=/opt/empiria/python
RUN uv python install 3.13
RUN uv venv /opt/empiria/.venv
ENV VIRTUAL_ENV="/opt/empiria/.venv"
ENV PATH="/opt/empiria/.venv/bin:$PATH"

# mnemosyne CLI: vault operational commands.
# uv pip can exit 0 with a partial install under network flakiness; the
# `test -x` + `--help` guard fails the build if the binary did not materialise.
# Surfaces silent install regressions at CI time, not after agent start.
# Installed to /opt/empiria/.venv/bin/mnemosyne (NOT /home/scion/.venv/...) so the
# binary survives SCION's home-directory mount overlay.
#
# Cache-bust: `RUN uv pip install git+...` is keyed on the command string, so
# buildx will reuse a cached layer even when the remote branch advances. The
# `--build-arg MNEMOSYNE_REV=<commit-sha>` (passed by publish-images.yml as
# `${{ github.sha }}`) invalidates this layer on every push to mnemosyne-cli/main.
ARG MNEMOSYNE_REV=unset
RUN echo "Installing mnemosyne-cli (cache-bust rev=${MNEMOSYNE_REV})" \
 && uv pip install git+https://github.com/Empiria/mnemosyne-cli.git \
 && test -x /opt/empiria/.venv/bin/mnemosyne \
 && /opt/empiria/.venv/bin/mnemosyne --help >/dev/null

# rustup: Rust toolchain for cargo dependencies
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
ENV PATH="/home/scion/.cargo/bin:$PATH"

# Claude Code: pinned native install + disable background auto-updater.
#
# Mechanism. The scion-claude parent image installs claude as a root-owned
# npm-global package. That approach has two failure modes for fresh agents:
#   1. The npm-global path is owned by root and outside the /home/scion mount
#      overlay, so the auto-updater's writability check fails and prints
#      "couldn't auto-update" on every start.
#   2. claude 2.1.x prints a "switched from npm install to native installation"
#      migration nag on every interactive startup pointing operators to
#      https://code.claude.com/docs/en/setup#install-claude-code.
# The native installer (Anthropic-signed, see https://claude.ai/install.sh)
# drops both nags. We pin the version by passing it as the install.sh
# argument; auto-update is still disabled via DISABLE_AUTOUPDATER (works
# for native installs per the docs — only stops the background check,
# `claude update`/`claude install` still work).
#
# Layout. install.sh writes the binary to $HOME/.local/share/claude/
# versions/<pin>; at build time $HOME=/root so we move it to /opt/claude/
# (system-wide, scion-readable) and symlink /usr/local/bin/claude into it.
# The /opt path survives the SCION /home/scion mount overlay; the npm
# install dir at /usr/local/share/npm-global/ does the same, but the
# native binary doesn't need an updater-writable parent.
USER root
RUN curl -fsSL https://claude.ai/install.sh | bash -s 2.1.110 \
 && mv /root/.local/share/claude /opt/claude \
 && rm -f /root/.local/bin/claude \
 && npm uninstall -g @anthropic-ai/claude-code \
 && ln -sf /opt/claude/versions/2.1.110 /usr/local/bin/claude \
 && /usr/local/bin/claude --version \
 && test "$(command -v claude)" = "/usr/local/bin/claude"
ENV DISABLE_AUTOUPDATER=1
USER scion

# Pre-create dep-cache subdirs so named volume is agent-owned on first mount
RUN mkdir -p ~/.dep-cache/uv ~/.dep-cache/ms-playwright ~/.dep-cache/cargo

# GSD: phase-based workflow skills, agents, and hooks for Claude Code.
# Three-step install:
#   1. `npm install -g get-shit-done-cc` puts the installer on PATH.
#   2. `get-shit-done-cc --claude --global` runs the installer (writes config
#      into ~/.claude/; --global is the installer's own flag, NOT npm -g).
#   3. The get-shit-done-cc npm package ships `gsd-tools` as a library
#      script (bin/gsd-tools.cjs) rather than a declared bin entry, so
#      `npm install -g` does NOT expose `gsd-tools` on PATH. We symlink
#      the .cjs (executable, `#!/usr/bin/env node` shebang) into the
#      npm-global bin dir which IS on the runtime PATH.
# The which-check fails the build if the symlink did not register.
RUN npm install -g get-shit-done-cc \
 && get-shit-done-cc --claude --global \
 && ln -sf /usr/local/share/npm-global/lib/node_modules/get-shit-done-cc/get-shit-done/bin/gsd-tools.cjs /usr/local/share/npm-global/bin/gsd-tools \
 && which gsd-tools >/dev/null

# Community hooks gap. The npm package's installer enables two opt-in
# SessionStart/PreToolUse hooks in ~/.claude/settings.json that reference
# gsd-session-state.sh and gsd-validate-commit.sh, but the npm-packaged
# install does NOT ship those scripts. Result: every claude invocation in
# a fresh agent errors with "no such file" before the opt-in check inside
# the hooks can short-circuit (the hooks themselves are no-ops unless
# .planning/config.json sets hooks.community=true). We ship the scripts
# from this repo's community-hooks/ directory into a known build-time
# location at /opt/empiria/community-hooks/; the vault's post-start.sh
# copies them into the agent's live ~/.claude/hooks/ after the
# get-shit-done-cc re-install runs. See agents/scion-template/hooks/
# post-start.sh in the vault for the deposit step. Surfaced during Phase
# 33.2 UAT — backlog item to upstream into get-shit-done-cc.
COPY --chmod=0755 community-hooks/*.sh /opt/empiria/community-hooks/

# Run as root so sciontool init can chown mounted volumes before dropping
# to scion. Requires the podman ExecUser fix (scion PR #XX) so the broker
# execs as scion to find the tmux socket at /tmp/tmux-1000/.
USER root
